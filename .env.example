# ===========================
# RAG Chatbot - Environment Configuration
# ===========================

# API Keys
GROQ_API_KEY=your-groq-api-key

# ===========================
# Paths Configuration
# ===========================

DATA_FOLDER=data
UPLOAD_FOLDER=data/uploaded_files
VECTORSTORE_FOLDER=vectorstore
DB_FAISS_NAME=db_faiss
CHUNKS_FILE=chunks.pkl
DOCS_FILE=docs.pkl

# ===========================
# LLM Configuration (Groq)
# ===========================

# Available models: llama-3.3-70b-versatile, mixtral-8x7b-32768, gemma-7b-it, etc.
GROQ_MODEL_NAME=llama-3.3-70b-versatile

# Temperature: 0.0 (deterministic) to 2.0 (creative)
LLM_TEMPERATURE=0.5

# Maximum tokens in response
LLM_MAX_TOKENS=2048

# ===========================
# Embedding Model Configuration
# ===========================

# HuggingFace embedding model
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# ===========================
# Retriever Configuration
# ===========================

# Number of documents to retrieve with FAISS
FAISS_SEARCH_K=3

# Number of documents to retrieve with BM25
BM25_SEARCH_K=5

# Hybrid retriever weights (must sum to 1.0)
# BM25_WEIGHT + FAISS_WEIGHT should equal 1.0
BM25_WEIGHT=0.3
FAISS_WEIGHT=0.7

# ===========================
# Text Processing Configuration
# ===========================

# Document chunk size in characters
CHUNK_SIZE=500

# Overlap between chunks
CHUNK_OVERLAP=50

# ===========================
# QA Chain Configuration
# ===========================

# Chain type: stuff, map_reduce, refine, map_rerank
CHAIN_TYPE=stuff

# Return source documents with response
RETURN_SOURCE_DOCUMENTS=true

# ===========================
# Streamlit UI Configuration
# ===========================

# Page configuration
STREAMLIT_PAGE_TITLE=Ask Chatbot
STREAMLIT_PAGE_ICON=💬

# Maximum number of source documents to display
MAX_SOURCE_DOCS_DISPLAY=5

# Length of source content preview
DISPLAY_CONTENT_LENGTH=500

# ===========================
# File Upload Configuration
# ===========================

# Maximum file size in MB
MAX_FILE_SIZE_MB=50

# ===========================
# Feature Flags
# ===========================

# Enable debug logging
DEBUG=false

# Enable performance monitoring
ENABLE_MONITORING=false
